# Neon Postgres connection string for the Forever archive (server-side
# only). When set, the archive uses Postgres (archive-db.ts); when unset,
# it falls back to local JSON files under data/archive/.
DATABASE_URL=

# Riot Games API key (server-side only — never exposed to the client).
# Get one at https://developer.riotgames.com
# Development keys expire every 24 hours and must NOT be used for a public
# product. Apply for a Production key before launching publicly.
RIOT_API_KEY=
